apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: http://{{ prometheus_host | default('127.0.0.1') }}:{{ prometheus_port | default(9090) }}
    isDefault: true
    jsonData:
      timeInterval: 10s
    editable: true

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://{{ loki_host | default('127.0.0.1') }}:{{ loki_port | default(3100) }}
    jsonData:
      maxLines: 1000
    editable: true

  - name: Tempo
    type: tempo
    uid: tempo
    access: proxy
    url: http://{{ tempo_host | default('127.0.0.1') }}:{{ tempo_port | default(3200) }}
    jsonData:
      httpMethod: GET
      tracesToLogsV2:
        datasourceUid: loki
        spanStartTimeShift: '-1h'
        spanEndTimeShift: '1h'
        filterByTraceId: true
        filterBySpanId: false
      tracesToMetrics:
        datasourceUid: prometheus
      serviceMap:
        datasourceUid: prometheus
      search:
        hide: false
      nodeGraph:
        enabled: true
      lokiSearch:
        datasourceUid: loki
    editable: true
