global:
  scrape_interval: 10s
  evaluation_interval: 10s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['127.0.0.1:9090']

  - job_name: 'monitoring_server'
    static_configs:
      - targets: ['127.0.0.1:9100']
        labels:
          server_name: 'monitoring-grafana'
          service: 'Monitoring & Observability'
          category: 'Observability'
          environment: 'prod'
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'gateway'
    static_configs:
{% if eks_nodes is defined and eks_nodes.gateway is defined %}
{% for node in eks_nodes.gateway %}
      - targets: ['{{ node.ip }}:9100']
        labels:
          server_name: 'gateway-node-0{{ loop.index }} (AZ-{{ ["a","b","c"][loop.index0] }})'
          service: 'APISIX Ingress Gateway'
          category: 'API Gateway & Ingress'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'integration'
    static_configs:
{% if eks_nodes is defined and eks_nodes.integration is defined %}
{% for node in eks_nodes.integration %}
      - targets: ['{{ node.ip }}:9100']
        labels:
          server_name: 'integration-node-0{{ loop.index }} (AZ-{{ ["a","b","c"][loop.index0] }})'
          service: 'Microservices (KSA, COD, Cloud7)'
          category: 'Microservices Integrations'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'application'
    static_configs:
{% if eks_nodes is defined and eks_nodes.application is defined %}
{% for node in eks_nodes.application %}
      - targets: ['{{ node.ip }}:9100']
        labels:
          server_name: 'application-node-0{{ loop.index }} (AZ-{{ ["a","b","c"][loop.index0] }})'
          service: 'Data Governance Core'
          category: 'Core Applications'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'cache'
    static_configs:
{% if eks_nodes is defined and eks_nodes.cache is defined %}
{% for node in eks_nodes.cache %}
      - targets: ['{{ node.ip }}:9100']
        labels:
          server_name: 'cache-aerospike-0{{ loop.index }} (AZ-{{ ["a","b","c"][loop.index0] }})'
          service: 'Aerospike Cache'
          category: 'Distributed In-Memory Cache'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'messaging'
    static_configs:
{% if eks_nodes is defined and eks_nodes.messaging is defined %}
{% for node in eks_nodes.messaging %}
      - targets: ['{{ node.ip }}:9100']
        labels:
          server_name: 'messaging-kafka-0{{ loop.index }} (AZ-{{ ["a","b","c"][loop.index0] }})'
          service: 'Kafka & Temporal'
          category: 'Event Streaming & Workflows'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'system'
    static_configs:
{% if eks_nodes is defined and eks_nodes.system is defined %}
{% for node in eks_nodes.system %}
      - targets: ['{{ node.ip }}:9100']
        labels:
          server_name: 'system-platform-0{{ loop.index }} (AZ-{{ ["a","b","c"][loop.index0] }})'
          service: 'ArgoCD, Keycloak, Infisical'
          category: 'Platform & Management'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'scylladb'
    static_configs:
{% for host in groups['scylladb_nodes'] %}
      - targets: ['{{ host }}:9100']
        labels:
          server_name: 'scylladb-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'ScyllaDB Cluster'
          category: 'Database - ScyllaDB'
          environment: 'prod'
{% endfor %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'clickhouse'
    static_configs:
{% for host in groups['clickhouse_nodes'] %}
      - targets: ['{{ host }}:9100']
        labels:
          server_name: 'clickhouse-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'ClickHouse OLAP'
          category: 'Database - ClickHouse'
          environment: 'prod'
{% endfor %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'yugabytedb'
    static_configs:
{% for host in groups['yugabytedb_nodes'] %}
      - targets: ['{{ host }}:9101']
        labels:
          server_name: 'yugabyte-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'YugabyteDB SQL'
          category: 'Database - YugabyteDB'
          environment: 'prod'
{% endfor %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  # --- SERVICE-LEVEL METRICS ---
  - job_name: 'scylladb_service'
    metrics_path: '/metrics'
    static_configs:
{% if groups['scylladb_nodes'] is defined and groups['scylladb_nodes'] | length > 0 %}
{% for host in groups['scylladb_nodes'] %}
      - targets: ['{{ host }}:9180']
        labels:
          server_name: 'scylladb-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'ScyllaDB Service'
          category: 'Database Service'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'clickhouse_service'
    metrics_path: '/metrics'
    static_configs:
{% if groups['clickhouse_nodes'] is defined and groups['clickhouse_nodes'] | length > 0 %}
{% for host in groups['clickhouse_nodes'] %}
      - targets: ['{{ host }}:9363']
        labels:
          server_name: 'clickhouse-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'ClickHouse Service'
          category: 'Database Service'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'yugabytedb_tserver'
    metrics_path: '/prometheus-metrics'
    static_configs:
{% if groups['yugabytedb_nodes'] is defined and groups['yugabytedb_nodes'] | length > 0 %}
{% for host in groups['yugabytedb_nodes'] %}
      - targets: ['{{ host }}:9000']
        labels:
          server_name: 'yugabyte-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'YugabyteDB TServer'
          category: 'Database Service'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

  - job_name: 'yugabytedb_master'
    metrics_path: '/prometheus-metrics'
    static_configs:
{% if groups['yugabytedb_nodes'] is defined and groups['yugabytedb_nodes'] | length > 0 %}
{% for host in groups['yugabytedb_nodes'] %}
      - targets: ['{{ host }}:7000']
        labels:
          server_name: 'yugabyte-node-0{{ loop.index }} (AZ-{{ ["a", "b", "c"][loop.index0] }})'
          service: 'YugabyteDB Master'
          category: 'Database Service'
          environment: 'prod'
{% endfor %}
{% endif %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance

{% if groups['redis_nodes'] is defined and groups['redis_nodes'] | length > 0 %}
  - job_name: 'redis_exporter'
    metrics_path: '/metrics'
    static_configs:
{% for host in groups['redis_nodes'] %}
      - targets: ['{{ host }}:9121']
        labels:
          server_name: 'redis-node-0{{ loop.index }}'
          service: 'Redis Cache'
          category: 'Cache Service'
          environment: 'prod'
{% endfor %}
    relabel_configs:
      - source_labels: [server_name]
        target_label: instance
{% endif %}

